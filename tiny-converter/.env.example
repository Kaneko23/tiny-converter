# Copie este arquivo para ".env.local" (ou configure em Project Settings > Environment
# Variables na Vercel) e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).
#
# Se deixar em branco / não configurar, a ferramenta funciona normalmente no
# navegador (upload -> conversão -> download), só não salva nada entre sessões
# (sem login, sem mapeamentos salvos, sem catálogo, sem clientes).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
